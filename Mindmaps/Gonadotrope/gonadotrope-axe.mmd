mindmap
  root["🧬 Axe gonadotrope (HHG) — homme (p. 51-53)"]
    Hypothalamus["Hypothalamus — GnRH"]
      GnRH_LH["GnRH → LH"]
      GnRH_FSH["GnRH → FSH"]
    Hypophyse["Hypophyse (gonadotrophines)"]
      LH["LH → cellules de Leydig → testostérone (androgènes)"]
      FSH["FSH → spermatogenèse + inhibine (cellules de Sertoli)"]
    Gonade["Testicule (gonade)"]
      Leydig["Cellules de Leydig interstitielles → testostérone (stim. surtout par LH)"]
      Sertoli["Cellules de Sertoli / tubes séminifères → spermatogenèse (stim. surtout par FSH)"]
      FonctionsGonade["Fonctions: gamètes (spermatogenèse) + hormones sexuelles (testostérone)"]
    Testosterone["Testostérone (T)"]
      T_SHBG["Liée fortement à la SHBG"]
      T_DHT["5α-réductase → 5α-DHT (action bien plus forte que T)"]
      T_cibles["T: peau/phanères, prostate, vésicule séminale ; DHT: organes génitaux accessoires, pilosité masculine, glandes sébacées"]
      T_rythme["Sécrétion circadienne (matin ~20% > moyenne)"]
    Retrocontrole["Rétrocontrôle négatif"]
      FB_T["Testostérone → feedback négatif: hypothalamus (GnRH) + hypophyse (LH)"]
      FB_Inhibine["Inhibine (Sertoli) → feedback négatif: hypophyse (FSH)"]
    Hypogonadisme["Hypogonadisme (déficit activité endocrine des gonades)"]
      Primaire["(1) Hypergonadotrope = primaire — atteinte de la gonade ; T/spermato ↓, FSH/LH ↑ (compensation)"]
        Prim_causes["Causes: congénital (agénésie/dysgénésie, anorchie, Klinefelter XXY) ; acquis (trauma, castration, cryptorchidie, orchite, radio/chimio, alcool)"]
        Prim_clin["Typique: très petits testicules ; FSH ↑↑ (spermatogenèse), LH ↑ (T)"]
        Klinefelter["Klinefelter (47,XXY) = cause la plus fréquente — oligo/azoospermie + ↓ testostérone ; Dg: caryotype"]
      Secondaire["(2) Hypo-/normogonadotrope = secondaire — manque de stimulus ; T/spermato ↓, FSH/LH normal à ↓"]
        Sec_causes["Causes: déficit neurones à GnRH (Kallmann + anosmie), insuffisance hypophysaire, hyperprolactinémie, alcool, abus d'androgènes/dopage, opiacés, corticoïdes, hémochromatose, adiposité"]
    Clinique["Clinique / conséquences"]
      Conge["Si congénital/sévère: absence de puberté spontanée, proportions eunuchoïdes, pas de mue de la voix, peu de pilosité"]
      Acquis["Si acquis: ↓ muscle, ostéopénie/ostéoporose, anémie, gynécomastie, ↓ libido/puissance, dysfonction érectile, dépression/fatigue"]
    Diagnostic["Diagnostic"]
      Hormones["Testostérone (tôt le matin), FSH/LH (hyper- vs hypogonadotrope)"]
      Sperme["Spermiogramme (concentration, motilité, morphologie)"]
    Therapie["Traitement"]
      HRT["Substitution testostérone (i.m.) — hypogonadisme primaire ET secondaire"]
      Gn["Substitution/stimulation des gonadotrophines (parentéral) — rare, pour la fertilité"]
    Puberte["Puberté (p. 131, Tanner)"]
      Pubarche["Pubarche (P2): pilosité pubienne par action androgénique (8-14 ans)"]
      Thelarche["Thélarche (M2): ↑ taille mamelon par effet œstrogénique"]
      Menarche["Ménarche: 1re menstruation spontanée (CH ~12,5 ans)"]
    Femme["Axe féminin / cycle menstruel"]
      Renvoi["Non détaillé ici — renvoi à « Endokrine Gynäkologie » (p. 53)"]
