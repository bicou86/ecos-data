mindmap
  root["🟠 Glande surrénale (Nebenniere)"]
    cortex["CORTEX (NNR)<br/>hormones stéroïdes — Cholestérol = précurseur"]
      zg["Zona glomerulosa"]
        zg1["→ Minéralocorticoïdes : ALDOSTÉRONE"]
        zg2["Stimulus : Angiotensine II (& ACTH)"]
        zg3["RAAS : rénine (appareil juxta-glomérulaire) → Angiotensinogène → Ang I (rénine) → Ang II (ECA, surtout poumon)"]
        zg4["Effet : ↑ réabsorption Na+ dans le rein (& autres organes)"]
        zg5["→ ↓ Na+ dans urine, sueur, selles ; rétention hydro-sodée, perte de K+"]
      zf["Zona fasciculata"]
        zf1["→ Glucocorticoïdes : CORTISOL"]
        zf2["Stimulus : ACTH"]
        zf3["Effets physiologiques : ↑ néoglucogenèse, ↑ glycogénogenèse, lipolyse, ↓ captation périphérique de glucose"]
        zf4["↑ débit cardiaque, ↑ résistances périphériques, ↑ GFR ; anti-inflammatoire / immunosuppresseur"]
        zf5["Pic au petit matin (rythme circadien)"]
      zr["Zona reticularis"]
        zr1["→ Stéroïdes sexuels : ANDROGÈNES"]
        zr2["Stimulus : ACTH (& cortisol)"]
        zr3["Produits : DHEA, DHEA-sulfate (produit principal), Androstènedione"]
        zr4["Action androgène faible ; conversion périphérique → testostérone & DHT (plus puissants)"]
    medulla["MÉDULLAIRE (NNM)<br/>cellules chromaffines"]
      m1["→ Catécholamines : Adrénaline & Noradrénaline"]
      m2["Stimulus : sympathique (sécrétion par acétylcholine, fibres pré-ganglionnaires)"]
      m3["Synthèse : Phénylalanine → Tyrosine → DOPA → Dopamine → Noradrénaline → Adrénaline"]
      m4["Récepteurs α1 (vasoconstriction), α2 (présynaptique), β1 (myocarde : ino/chrono/dromotrope +, rénine), β2 (vasodilatation, bronchodilatation), β3 (lipolyse)"]
