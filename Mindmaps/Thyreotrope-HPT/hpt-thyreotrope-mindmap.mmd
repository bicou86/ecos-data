mindmap
  root["Axe thyréotrope (HPT / HHS)"]
    H["1 · Hypothalamus → TRH"]
      H1["TRH inhibée par : somatostatine, dopamine, glucocorticoïdes"]
    P["2 · Hypophyse ant. → TSH"]
      P1["récepteur couplé protéine G → synthèse + sécrétion + croissance/vascularisation"]
      P2["stimulée par la TRH"]
    T["3 · Thyroïde → T4 ≫ T3"]
      T1["sécrétion surtout T4 (100 nmol/j) ≫ T3 (5 nmol/j)"]
      T2["T4 = pro-hormone → T3 actif par 5'-désiodase (aussi rT3 inactif)"]
      T3n["transport : TBG 75%, transthyrétine 10%, albumine 15%"]
      T4n["liaison déplacée par salicylés, phénytoïne"]
      T5["demi-vie : T4 7 j, T3 1 j"]
    EFF["4 · Effets de T3 (récepteurs intracellulaires → transcription)"]
      EF1["↑ métabolisme basal / O2 (Na-K-ATPase, thermogenèse)"]
      EF2["↑ néoglucogenèse, glycogénolyse, lipolyse ; ↑ turnover cholestérol → ↓ cholestérol sanguin"]
      EF3["cœur : inotrope+ / chronotrope+, ↑ GFR"]
      EF4["croissance : ↑ (via GH + effet osseux direct)"]
      EF5["SNC : carence durant le développement → crétinisme"]
      EF6["digestif : ↑ motilité intestinale"]
    FB["5 · Rétrocontrôle négatif"]
      FB1["fT3 et T4 inhibent hypothalamus (TRH) ET hypophyse (TSH)"]
    AR["6 · Autorégulation (TSH-indépendante)"]
      AR1["effet Wolff-Chaikoff : excès d'iode → ↓ synthèse, échappement en 2-4 sem"]
    AI["7 · Auto-immunité"]
      AI1["Ac stimulants anti-récepteur TSH → Basedow (hyperthyroïdie)"]
      AI2["inhibition → thyroïdite chronique (Hashimoto, hypothyroïdie)"]
