// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderCard > renders the golden SSP card to HTML 1`] = `
"<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Céphalée — SSP-NEU-04</title>
    <link rel="stylesheet" href="../assets/card.css" />
  </head>
  <body>
    <article
      class="card"
      data-type="ssp"
      data-discipline="Neuro"
    >
      <header class="card-header">
        <h1>Céphalée</h1>
        <div>
                    <span class="urgency high"
            >high</span
          >
                    <span class="meta"
            >SSP-NEU-04 · Neuro · v2026-05-27</span
          >
        </div>
      </header>

      <div class="grid">
        <section class="section anam">
          <div class="label">📋 Anamnèse</div>
          <strong>SOCRATES</strong>
          <ul>
                        <li>Site (uni/bilatéral, localisation)</li>
                        <li>Onset (brutal vs progressif)</li>
                        <li>Character (pulsatile, étau)</li>
                        <li>Radiation (nuque, mâchoire)</li>
                        <li>Time (durée, fréquence)</li>
                        <li>Exacerbating (effort, lumière)</li>
                        <li>Relieving (repos, médicaments)</li>
                        <li>Severity (0-10)</li>
                      </ul>
          <strong>Spécifique</strong>
          <ul>
                        <li>Aura visuelle/sensitive</li>
                        <li>Photo/phonophobie</li>
                        <li>Nausées/vomissements</li>
                      </ul>
          <strong>ATCD</strong>
          <ul>
                        <li>Céphalées habituelles</li>
                        <li>Migraine familiale</li>
                      </ul>
        </section>

        <section class="section rf">
          <div class="label">🚨 Red flags</div>
          <ul class="rf-list">
                        <li>
              <div>Coup de tonnerre (&lt; 1 min)</div>
              <div class="dx">→ HSA</div>
              <div class="action">CT cérébral immédiat</div>
            </li>
                        <li>
              <div>« Pire de ma vie »</div>
              <div class="dx">→ HSA, dissection</div>
              <div class="action">Imagerie urgente</div>
            </li>
                        <li>
              <div>Déficit neurologique focal nouveau</div>
              <div class="dx">→ AVC, tumeur</div>
              <div class="action">AVC pathway</div>
            </li>
                      </ul>
        </section>

        <section class="section exam">
          <div class="label">🔍 Examen</div>
          <strong>Général</strong>
          <ul>
                        <li>TA, FC, T°, SatO2</li>
                        <li>Glasgow</li>
                      </ul>
          <strong>Ciblé</strong>
          <ul>
                        <li>Status neuro complet</li>
                        <li>FO (œdème papillaire)</li>
                        <li>Palpation artères temporales</li>
                      </ul>
        </section>

        <section class="section dd">
          <div class="label">🎯 DD Top 5</div>
          <ul class="dd-list">
                        <li>
              <div class="dx">Migraine</div>
              <div class="indices">Pulsatile, photo/phono, aura</div>
              <div class="freq">très fréquent</div>
            </li>
                        <li>
              <div class="dx">Céphalée de tension</div>
              <div class="indices">Bilatérale, étau, sans aura</div>
              <div class="freq">fréquent</div>
            </li>
                        <li>
              <div class="dx">HSA</div>
              <div class="indices">Thunderclap, méningisme</div>
              <div class="freq">rare/urgent</div>
            </li>
                        <li>
              <div class="dx">Horton</div>
              <div class="indices">&gt;50a, claudication mâchoire, CRP↑</div>
              <div class="freq">rare</div>
            </li>
                        <li>
              <div class="dx">Méningite</div>
              <div class="indices">Fièvre + raideur + altération</div>
              <div class="freq">rare/urgent</div>
            </li>
                      </ul>
        </section>

        <section class="section pec full">
          <div class="label">💊 Prise en charge initiale</div>
          <strong>Immédiat</strong>
          <ul>
                        <li>Antalgie AINS / Paracétamol</li>
                        <li>Triptan si migraine confirmée</li>
                      </ul>
          <strong>Orientation</strong>
          <ul>
                        <li>Domicile + suivi MT si bénin</li>
                        <li>URG si red flag</li>
                      </ul>
        </section>

                <section class="section">
          <div class="label">🧪 Examens complémentaires</div>
          <ul>
                        <li>CT cérébral (red flag)</li>
                        <li>IRM (céphalée progressive)</li>
                        <li>CRP/VS (Horton)</li>
                      </ul>
        </section>
                 <section class="section">
          <div class="label">🏥 Critères d'hospitalisation</div>
          <ul>
                        <li>Imagerie anormale</li>
                        <li>Altération de conscience</li>
                      </ul>
        </section>
                 <section class="section full">
          <div class="label">💡 Pièges / Pearls</div>
          <ul>
                        <li>Oublier le FO devant une céphalée nouvelle</li>
                        <li>Triptan contre-indiqué dans HSA</li>
                      </ul>
        </section>
              </div>

      <footer class="card-footer">
        <span>Sources : CS/02_SSP/SSP_Céphalee.md</span>
                <span class="linked"
          >Liées : <a
            href="SYS-NEU.html"
            >SYS-NEU</a
          > · <a
            href="TOOL-NIHSS.html"
            >TOOL-NIHSS</a
          >        </span>
              </footer>
    </article>
  </body>
</html>
"
`;

exports[`renderCard > renders the golden SYS card to HTML 1`] = `
"<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Cardio — SYS-CAR</title>
    <link rel="stylesheet" href="../assets/card.css" />
  </head>
  <body>
    <article
      class="card"
      data-type="sys"
      data-discipline="Cardio"
    >
      <header class="card-header">
        <h1>
          Cardio          <small style="opacity:.7;font-size:13px;">— Système</small>
        </h1>
        <span class="meta">SYS-CAR · v2026-05-27</span>
      </header>

      <div class="grid">
        <section class="section anam">
          <div class="label">📋 Anamnèse par appareil</div>
          <ul>
                        <li>Douleur thoracique</li>
                        <li>Dyspnée</li>
                        <li>Palpitations</li>
                        <li>Syncope</li>
                        <li>Œdèmes des membres inférieurs</li>
                      </ul>
        </section>

        <section class="section exam">
          <div class="label">🔍 Status d'examen</div>
          <ul>
                        <li>Inspection (cyanose, jugulaires)</li>
                        <li>Palpation (choc de pointe, frémissements)</li>
                        <li>Percussion (matité aire cardiaque)</li>
                        <li>Auscultation (B1, B2, souffles, frottement)</li>
                      </ul>
        </section>

        <section class="section exam full">
          <div class="label">✋ Manœuvres spécifiques</div>
          <ul>
                        <li>Reflux hépatojugulaire</li>
                        <li>Manœuvre de Valsalva</li>
                        <li>Test orthostatique</li>
                        <li>Pouls périphériques bilatéraux</li>
                      </ul>
        </section>

                <section class="section">
          <div class="label">📊 Échelles / scores</div>
          <ul>
                        <li>NYHA</li>
                        <li>CHA2DS2-VASc</li>
                        <li>HAS-BLED</li>
                      </ul>
        </section>
                 <section class="section">
          <div class="label">🔗 SSPs liées</div>
          <ul>
                        <li><a href="SSP-CAR-01.html">SSP-CAR-01</a></li>
                        <li><a href="SSP-CAR-04.html">SSP-CAR-04</a></li>
                      </ul>
        </section>
              </div>

      <footer class="card-footer">
        <span>Sources : CS/04_Skills_Examen/Cardio/Skills/Cardio.pdf</span>
      </footer>
    </article>
  </body>
</html>
"
`;

exports[`renderCard > renders the golden TOOL card to HTML 1`] = `
"<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>NIHSS — TOOL-NIHSS</title>
    <link rel="stylesheet" href="../assets/card.css" />
  </head>
  <body>
    <article
      class="card"
      data-type="tool"
      data-discipline="Neuro"
    >
      <header class="card-header">
        <h1>
          NIHSS          <small style="opacity:.7;font-size:13px;">— Outil</small>
        </h1>
        <span class="meta"
          >TOOL-NIHSS · Neuro · v2026-05-27</span
        >
      </header>

      <div class="grid">
        <section class="section anam">
          <div class="label">❓ Quand l'utiliser</div>
          <ul>
                        <li>AVC suspect (évaluation initiale)</li>
                        <li>Suivi post-thrombolyse</li>
                        <li>Évaluation gravité pour décision thérapeutique</li>
                      </ul>
        </section>

        <section class="section exam">
          <div class="label">📝 Items</div>
          <ul>
                        <li>Niveau de conscience</li>
                        <li>Questions orientation (mois, âge)</li>
                        <li>Commandes simples</li>
                        <li>Mouvements oculaires</li>
                        <li>Champ visuel</li>
                        <li>Paralysie faciale</li>
                        <li>Force MS droit/gauche</li>
                        <li>Force MI droit/gauche</li>
                        <li>Ataxie</li>
                        <li>Sensibilité</li>
                        <li>Langage</li>
                        <li>Dysarthrie</li>
                        <li>Extinction/Négligence</li>
                      </ul>
        </section>

        <section class="section dd full">
          <div class="label">🧮 Score / Interprétation</div>
          <table style="width:100%;border-collapse:collapse;font-size:11px;">
            <thead>
              <tr style="background:rgba(245,158,11,.15);">
                <th style="text-align:left;padding:4px 8px;">Score</th>
                <th style="text-align:left;padding:4px 8px;">Interprétation</th>
              </tr>
            </thead>
            <tbody>
                            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:4px 8px;font-weight:600;">
                  0                </td>
                <td style="padding:4px 8px;">Pas de déficit</td>
              </tr>
                            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:4px 8px;font-weight:600;">
                  1-4                </td>
                <td style="padding:4px 8px;">AVC mineur</td>
              </tr>
                            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:4px 8px;font-weight:600;">
                  5-15                </td>
                <td style="padding:4px 8px;">AVC modéré</td>
              </tr>
                            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:4px 8px;font-weight:600;">
                  16-20                </td>
                <td style="padding:4px 8px;">AVC modéré à sévère</td>
              </tr>
                            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:4px 8px;font-weight:600;">
                  &gt;20                </td>
                <td style="padding:4px 8px;">AVC sévère</td>
              </tr>
                          </tbody>
          </table>
        </section>

                <section class="section rf">
          <div class="label">⚠️ Limites</div>
          <ul>
                        <li>Sous-estime AVC postérieur</li>
                        <li>Pas d&#39;évaluation aphasie fine</li>
                      </ul>
        </section>
                 <section class="section">
          <div class="label">🔗 SSPs où l'utiliser</div>
          <ul>
                        <li><a href="SSP-NEU-AVC.html">SSP-NEU-AVC</a></li>
                        <li><a href="SSP-NEU-Vertige.html">SSP-NEU-Vertige</a></li>
                      </ul>
        </section>
              </div>

      <footer class="card-footer">
        <span>Sources : Neurocard - Echelles 2020.pdf</span>
      </footer>
    </article>
  </body>
</html>
"
`;

exports[`renderIndex > renders the index with all card links 1`] = `
"<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>ECOS Pocketcards — Index</title>
    <link rel="stylesheet" href="../assets/card.css" />
  </head>
  <body>
    <main class="index">
      <h1>ECOS Pocketcards</h1>
      <p style="color:#64748b;font-size:13px;">
        3 cartes · 1 SSP · 1 Systèmes · 1        Outils
      </p>

      <div class="filters" id="type-filters">
        <button class="active" data-filter="type" data-value="all">
          Tous types
        </button>
        <button data-filter="type" data-value="ssp">SSP</button>
        <button data-filter="type" data-value="sys">Système</button>
        <button data-filter="type" data-value="tool">Outil</button>
      </div>

      <div class="filters" id="discipline-filters">
        <button class="active" data-filter="discipline" data-value="all">
          Toutes disciplines
        </button>
                <button data-filter="discipline" data-value="Cardio">Cardio</button>
                <button data-filter="discipline" data-value="Neuro">Neuro</button>
              </div>

      <div class="cards" id="card-list">
                <a
          class="card-link urgency-high"
          href="SSP-NEU-04.html"
          data-type="ssp"
          data-discipline="Neuro"
        >
          <div class="id">SSP-NEU-04</div>
          <div class="title">Céphalée</div>
          <div class="disc">
            Neuro · high          </div>
        </a>
                <a
          class="card-link "
          href="SYS-CAR.html"
          data-type="sys"
          data-discipline="Cardio"
        >
          <div class="id">SYS-CAR</div>
          <div class="title">Cardio</div>
          <div class="disc">
            Cardio          </div>
        </a>
                <a
          class="card-link "
          href="TOOL-NIHSS.html"
          data-type="tool"
          data-discipline="Neuro"
        >
          <div class="id">TOOL-NIHSS</div>
          <div class="title">NIHSS</div>
          <div class="disc">
            Neuro          </div>
        </a>
              </div>
    </main>

    <script>
      const state = { type: "all", discipline: "all" };
      document.querySelectorAll("[data-filter]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.dataset.filter;
          state[key] = btn.dataset.value;
          document
            .querySelectorAll(\`[data-filter="\${key}"]\`)
            .forEach((b) =>
              b.classList.toggle("active", b.dataset.value === state[key]),
            );
          document.querySelectorAll(".card-link").forEach((c) => {
            const okType =
              state.type === "all" || c.dataset.type === state.type;
            const okDisc =
              state.discipline === "all" ||
              c.dataset.discipline === state.discipline;
            c.style.display = okType && okDisc ? "" : "none";
          });
        });
      });
    </script>
  </body>
</html>
"
`;
