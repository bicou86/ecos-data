{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ecos-data/schemas/pocketcard.schema.json",
  "title": "ECOS Pocketcard",
  "type": "object",
  "required": ["id", "type", "title", "discipline", "version", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(SSP|SYS|TOOL)-([A-Z]{3,4}(-\\d{2})?|[A-Z]{5,})$"
    },
    "type": { "enum": ["ssp", "sys", "tool"] },
    "title": { "type": "string", "minLength": 1 },
    "discipline": {
      "enum": [
        "Cardio",
        "Neuro",
        "MSQ",
        "Gastro",
        "Pulmo",
        "Endocrino",
        "Dermato",
        "Gyneco",
        "Pediatric",
        "Psy",
        "ORL",
        "Ophtalmo",
        "Urgences",
        "Comm",
        "Nephro",
        "Infectio",
        "Hemato",
        "Geriatrie",
        "Uro"
      ]
    },
    "urgency": { "enum": ["low", "medium", "high"] },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["draft", "review-pending", "ready"] },
    "sources": { "type": "array", "items": { "type": "string" } },
    "notion_last_synced": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "ssp" } } },
      "then": {
        "required": [
          "urgency",
          "anamnese",
          "red_flags",
          "examen",
          "dd_top5",
          "pec_initiale"
        ],
        "properties": {
          "anamnese": {
            "type": "object",
            "required": ["socrates", "specifique", "atcd"],
            "properties": {
              "socrates": { "type": "array", "items": { "type": "string" } },
              "specifique": { "type": "array", "items": { "type": "string" } },
              "atcd": { "type": "array", "items": { "type": "string" } }
            }
          },
          "red_flags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["description", "dx_suspecte", "action"],
              "properties": {
                "description": { "type": "string" },
                "dx_suspecte": { "type": "string" },
                "action": { "type": "string" }
              }
            }
          },
          "examen": {
            "type": "object",
            "required": ["general", "cible"],
            "properties": {
              "general": { "type": "array", "items": { "type": "string" } },
              "cible": { "type": "array", "items": { "type": "string" } }
            }
          },
          "dd_top5": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["dx", "indices", "freq"],
              "properties": {
                "dx": { "type": "string" },
                "indices": { "type": "string" },
                "freq": { "type": "string" }
              }
            }
          },
          "pec_initiale": {
            "type": "object",
            "required": ["immediate", "orientation"],
            "properties": {
              "immediate": { "type": "array", "items": { "type": "string" } },
              "orientation": { "type": "array", "items": { "type": "string" } }
            }
          },
          "examens_complementaires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "criteres_hospitalisation": {
            "type": "array",
            "items": { "type": "string" }
          },
          "pieges": { "type": "array", "items": { "type": "string" } },
          "cartes_liees": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "sys" } } },
      "then": {
        "required": ["anamnese_appareil", "examen_physique", "manoeuvres"],
        "properties": {
          "anamnese_appareil": {
            "type": "array",
            "items": { "type": "string" }
          },
          "examen_physique": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "manoeuvres": { "type": "array", "items": { "type": "string" } },
          "echelles": { "type": "array", "items": { "type": "string" } },
          "ssps_liees": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool" } } },
      "then": {
        "required": ["quand_utiliser", "items", "score_interpretation"],
        "properties": {
          "quand_utiliser": { "type": "array", "items": { "type": "string" } },
          "items": { "type": "array", "items": { "type": "string" } },
          "score_interpretation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["score", "interpretation"],
              "properties": {
                "score": { "type": "string" },
                "interpretation": { "type": "string" }
              }
            }
          },
          "limites": { "type": "array", "items": { "type": "string" } },
          "ssps_ou_utiliser": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  ]
}
